# Copy this file to .env and fill in your own secure values

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_very_secure_password_here
POSTGRES_DB=sunberry
DATABASE_URL=postgresql+asyncpg://postgres:your_very_secure_password_here@db/sunberry

# ── Backend / JWT ─────────────────────────────────────────────────────────────
SECRET_KEY=your_super_secret_jwt_key_here_make_it_long_and_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# Production: set to your GitHub Pages URL
CORS_ORIGINS=https://hemanth-e23.github.io

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Get this token from Cloudflare Zero Trust dashboard when you create the tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── Frontend (local dev only) ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
